diff --git a/src/tensorfold/tool_parameters.py b/src/tensorfold/tool_parameters.py
index d722004..791d027 100644
--- a/src/tensorfold/tool_parameters.py
+++ b/src/tensorfold/tool_parameters.py
@@ -8,6 +8,14 @@ from collections.abc import Sequence
 from typing import Any
 
 
+def keeps_parameter(key: str, properties: dict[str, Any] | None) -> bool:
+    """Whether a tool call's argument is kept: a tool that declares properties takes only those; one that
+    declares none takes every argument. Qwen3.8-Flash-Next (MLX 4-bit) sometimes adds an optional argument the
+    schema does not have (``formal`` on a translate tool); dropping it leaves the call the client asked for."""
+
+    return not properties or key in properties
+
+
 def parameter_schemas(tools: Sequence[dict[str, Any]] | None) -> dict[str, dict[str, Any]]:
     """Each offered tool's parameter schemas by lowercase name; a spec that is not an object reads as untyped."""
 
diff --git a/tests/test_cuda_tool_system.py b/tests/test_cuda_tool_system.py
new file mode 100644
index 0000000..504d93b
--- /dev/null
+++ b/tests/test_cuda_tool_system.py
@@ -0,0 +1,63 @@
+"""``--tool-system``: the CUDA server adds its instruction to a chat request that offers tools and has no system
+message. A request's own system message wins, and a request without tools is rendered as before."""
+
+import json
+
+from tests.test_cuda_admission import http_server, post
+from tests.test_cuda_tool_choice import EOS, Tokens, app_for
+
+TOOLS = [{"type": "function", "function": {"name": "echo", "parameters": {"type": "object", "properties": {}}}}]
+RULE = "Tool calls: include only the arguments the user gave."
+
+
+class Engine:
+    """Records the prompt it was given and answers 'ok'."""
+
+    eos = (EOS,)
+
+    def __init__(self):
+        self.prompts = []
+
+    def generate(self, prompt, max_tokens, sampling, on_tokens, draft=True):
+        self.prompts.append(Tokens().decode(prompt))
+        on_tokens(Tokens().encode("ok").ids + [EOS])
+        return {"rounds": 1, "decode_s": 0.1}
+
+
+def served(tmp_path, body, rule=RULE):
+    engine = Engine()
+    app = app_for(tmp_path, engine)
+    app.tool_system = rule
+    with http_server(app) as port:
+        status, text = post(port, body, True)
+    assert status == 200, text
+    return engine.prompts[-1]
+
+
+def test_tool_request_without_a_system_message_gets_the_rule(tmp_path):
+    prompt = served(tmp_path, {"messages": [{"role": "user", "content": "Say hello."}], "tools": TOOLS})
+    assert prompt.startswith(f"system:{RULE};user:Say hello.;tools:echo;")
+
+
+def test_the_clients_own_system_message_wins(tmp_path):
+    prompt = served(tmp_path, {"messages": [{"role": "system", "content": "Be brief."},
+                                            {"role": "user", "content": "Say hello."}], "tools": TOOLS})
+    assert prompt.startswith("system:Be brief.;user:Say hello.;tools:echo;") and RULE not in prompt
+
+
+def test_a_request_without_tools_is_untouched(tmp_path):
+    prompt = served(tmp_path, {"messages": [{"role": "user", "content": "Say hello."}]})
+    assert prompt.startswith("user:Say hello.;") and RULE not in prompt
+
+
+def test_no_rule_configured(tmp_path):
+    prompt = served(tmp_path, {"messages": [{"role": "user", "content": "Say hello."}], "tools": TOOLS}, rule=None)
+    assert prompt.startswith("user:Say hello.;tools:echo;")
+
+
+def test_cli_flag_reaches_the_server():
+    from tensorfold import cli
+
+    args = cli.build_parser().parse_args(["serve", "m", "--tool-system", RULE])
+    assert args.tool_system == RULE
+    assert cli.build_parser().parse_args(["serve", "m"]).tool_system is None
diff --git a/tests/test_tool_undeclared_arguments.py b/tests/test_tool_undeclared_arguments.py
new file mode 100644
index 0000000..b57691d
--- /dev/null
+++ b/tests/test_tool_undeclared_arguments.py
@@ -0,0 +1,65 @@
+"""A Qwen XML tool call keeps only the parameters the offered tool declares, on every parser and in the stream.
+
+Qwen3.8-Flash-Next (MLX 4-bit) sometimes adds an optional argument the schema does not have (``formal`` on a
+translate tool). A tool that declares no properties still takes every argument."""
+
+import json
+
+from tensorfold.cuda.reply_text import parse_tool_calls as cuda_parse
+from tensorfold.engine.tool_draft import ToolCallStreamer
+from tensorfold.server.tools import parse_tool_calls_from_content
+from tensorfold.tool_parameters import keeps_parameter
+
+TRANSLATE = {"type": "function", "function": {"name": "translate_text", "parameters": {
+    "type": "object", "properties": {"text": {"type": "string"}, "target": {"type": "string"},
+                                     "count": {"type": "integer"}},
+    "required": ["text", "target"]}}}
+FREEFORM = {"type": "function", "function": {"name": "echo", "parameters": {"type": "object"}}}
+CALL = ("<tool_call>\n<function=translate_text>\n<parameter=text>\nGuten Tag\n</parameter>\n"
+        "<parameter=formal>\nFalse\n</parameter>\n<parameter=target>\nen\n</parameter>\n"
+        "<parameter=count>\n2\n</parameter>\n</function>\n</tool_call>")
+WANT = {"text": "Guten Tag", "target": "en", "count": 2}
+
+
+def test_rule():
+    assert keeps_parameter("formal", {}) and keeps_parameter("formal", None)
+    assert keeps_parameter("text", {"text": {}}) and not keeps_parameter("formal", {"text": {}})
+
+
+def test_server_parser_drops_an_undeclared_argument():
+    residue, calls = parse_tool_calls_from_content(CALL, [TRANSLATE])
+    assert residue.strip() == "" and len(calls) == 1
+    assert json.loads(calls[0]["function"]["arguments"]) == WANT
+
+
+def test_cuda_parser_drops_an_undeclared_argument():
+    residue, calls = cuda_parse(CALL, [TRANSLATE])
+    assert residue.strip() == "" and len(calls) == 1
+    assert json.loads(calls[0]["function"]["arguments"]) == WANT
+
+
+def test_a_tool_without_properties_keeps_every_argument():
+    text = CALL.replace("translate_text", "echo")
+    _, calls = cuda_parse(text, [FREEFORM])
+    assert json.loads(calls[0]["function"]["arguments"]) == {"text": "Guten Tag", "formal": "False",
+                                                             "target": "en", "count": "2"}
+    _, calls = parse_tool_calls_from_content(text, [FREEFORM])
+    assert set(json.loads(calls[0]["function"]["arguments"])) == {"text", "formal", "target", "count"}
+
+
+def _streamed(text, tools, step):
+    streamer, deltas = ToolCallStreamer(tools), []
+    for at in range(0, len(text), step):
+        deltas += streamer.feed(text[:at + step])
+    return "".join(d["tool_calls"][0]["function"].get("arguments", "") for d in deltas)
+
+
+def test_stream_emits_no_delta_for_an_undeclared_argument():
+    for step in (1, 3, 7, len(CALL)):
+        assert json.loads(_streamed(CALL, [TRANSLATE], step)) == WANT, step
+    first = CALL.replace("<parameter=text>\nGuten Tag\n</parameter>\n", "")
+    first = first.replace("</function>", "<parameter=text>\nGuten Tag\n</parameter>\n</function>")
+    for step in (1, 5):   # the undeclared one comes first: the brace still opens on the first kept key
+        assert json.loads(_streamed(first, [TRANSLATE], step)) == WANT, step
+    only = "<tool_call>\n<function=translate_text>\n<parameter=formal>\nFalse\n</parameter>\n</function>\n</tool_call>"
+    assert json.loads(_streamed(only, [TRANSLATE], 4)) == {}
